+		if (filefmt_l >= sizeof(fbuf))
+			filefmt = NULL;
+		else {
+			memcpy(fbuf, filefmt, filefmt_l);
+			fbuf[filefmt_l] = '\0';
+			if (strcmp(fbuf, "not") == 0)
+				fmt = S_FFNA;
+			else if (strcmp(fbuf, "bin") == 0)
+				fmt = S_FFBINARY;
+			else if (strcmp(fbuf, "nl") == 0)
+				fmt = S_FFNL;
+			else if (strcmp(fbuf, "cr") == 0)
+				fmt = S_FFCR;
+			else if (strcmp(fbuf, "lf") == 0)
+				fmt = S_FFLF;
+			else if (strcmp(fbuf, "crlf") == 0)
+				fmt = S_FFCRLF;
+			else if (strcmp(fbuf, "lfcr") == 0)
+				fmt = S_FFLFCR;
+			else if (strcmp(fbuf, "crnl") == 0)
+				fmt = S_FFCRNL;
+#ifdef S_FFRECORD
+			else if (strcmp(fbuf, "rec") == 0)
+				fmt = S_FFRECORD;
+#endif
+			else
+				fmt = -1;
+			if (fmt >= 0) {
+				attrib_t at;
+				memset(&at, 0, sizeof(at));
+				at.att_id[0] = 'A'; at.att_id[1] = 'T';
+				at.att_id[2] = 'T'; at.att_id[3] = ' ';
+				at.att_version = 1;
+				at.att_filefmtchg = 1;
+				at.att_filefmt = (char)fmt;
+				r2 = zos_chattr(a, &at, "filefmt");
+				if (r2 < ret) ret = r2;
+			}
+		}
+	}
+
+	/* Extended attributes: 4 chars "apsl" ('-' = not set):
+	 *   a = APF-authorized, p = program controlled,
+	 *   s = shared address space, l = shared library. */
+	if (!is_link && is_reg) {
+		char ebuf[8];
+
+		if (extattr != NULL && extattr_l == 4) {
+			memcpy(ebuf, extattr, 4);
+			ebuf[4] = '\0';
+			r2 = zos_set_extattr(a, ebuf);
+			if (r2 < ret) ret = r2;
+		} else if (tarport_genvalue >= 0) {
+			/* ZOS.genvalue is present: apply the apsl bits
+			 * even when they are all zero, so that bits set
+			 * on the destination (e.g. an existing
+			 * __ST_NO_SHAREAS) are cleared to restore the
+			 * archived state. */
+			snprintf(ebuf, sizeof(ebuf), "%c%c%c%c",
+			    (tarport_genvalue & __ST_APF_AUTH) ? 'a' : '-',
+			    (tarport_genvalue & __ST_PROG_CTL) ? 'p' : '-',
+			    (tarport_genvalue & __ST_NO_SHAREAS) ? '-' : 's',
+#ifdef __ST_SHARE_LIB
+			    (tarport_genvalue & __ST_SHARE_LIB) ? 'l' : '-');
+#else
+			    '-');
+#endif
+			r2 = zos_set_extattr(a, ebuf);
+			if (r2 < ret) ret = r2;
+		}
+	}
+	return (ret);
+}
