+			attrib_t at;
+			memset(&at, 0, sizeof(at));
+			at.att_id[0] = 'A'; at.att_id[1] = 'T';
+			at.att_id[2] = 'T'; at.att_id[3] = ' ';
+			at.att_version = 1;
+			at.att_filetagchg = 1;
+			at.att_filetag.ft_ccsid = (unsigned short)ccsid;
+			at.att_filetag.ft_txtflag = 1;
+			r2 = zos_chattr(a, &at, "taginfo");
+			if (r2 < ret) ret = r2;
+		} else if (txtflag == 0 && ccsid >= 0 && ccsid <= 65535) {
+			/* Binary-tagged (e.g. CCSID 65535), or explicitly
+			 * untagged (CCSID 0): __chattr() with ccsid 0
+			 * clears any tag the destination file may have,
+			 * restoring the archived state. */
+			attrib_t at;
+			memset(&at, 0, sizeof(at));
+			at.att_id[0] = 'A'; at.att_id[1] = 'T';
+			at.att_id[2] = 'T'; at.att_id[3] = ' ';
+			at.att_version = 1;
+			at.att_filetagchg = 1;
+			at.att_filetag.ft_ccsid = (unsigned short)ccsid;
+			at.att_filetag.ft_txtflag = 0;
+			r2 = zos_chattr(a, &at, "taginfo");
+			if (r2 < ret) ret = r2;
+		}
+	}
