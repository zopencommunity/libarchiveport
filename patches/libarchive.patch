+/*
+ * z/OS: restore the ZOS.* pax extended-header attributes that IBM
+ * z/OS pax stores in archives (ZOS.taginfo, ZOS.useraudit,
+ * ZOS.auditoraudit, ZOS.filefmt, ZOS.extattr).  The tar reader
+ * parks these on the entry as extended attributes; translate them
+ * into __chattr()/__fchattr() calls here so that extraction is
+ * equivalent to IBM "pax -r -p e".
+ */
+
+/* Map one ZOS.useraudit/ZOS.auditoraudit character to an audit byte:
+ * '-' = none, 's' = successes, 'f' = failures, 'a' = both.
+ * (Verified against z/OS: the audit area is 4 bytes, one each for
+ * read/write/execute, with values 0=none 1=success 2=failure 3=both.)
+ */
+static int
+zos_audit_char(char c)
+{
+	switch (c) {
+	case '-': return (0);
+	case 's': return (1);
+	case 'f': return (2);
+	case 'a': return (3);
+	default:  return (-1);
+	}
+}
+
+/* Apply one attrib_t to the file being extracted. */
+static int
+zos_chattr(struct archive_write_disk *a, attrib_t *at, const char *what)
+{
+	if (a->fd >= 0) {
+		if (__fchattr(a->fd, at, sizeof(*at)) == 0)
+			return (ARCHIVE_OK);
+	} else {
+		if (__chattr(a->name, at, sizeof(*at)) == 0)
+			return (ARCHIVE_OK);
+	}
+	archive_set_error(&a->archive, errno,
+	    "Cannot restore z/OS %s attribute: %s", what, a->name);
+	return (ARCHIVE_WARN);
+}
+
+/* Apply user/auditor audit flags: three chars for read/write/execute. */
+static int
+zos_set_audit(struct archive_write_disk *a, int ret, int is_auditor,
+    const char *chars)
+{
+	attrib_t at;
+	int v[3], k;
+	unsigned char *b;
+
+	for (k = 0; k < 3; k++) {
+		v[k] = zos_audit_char(chars[k]);
+		if (v[k] < 0)
+			return (ret);
+	}
+	memset(&at, 0, sizeof(at));
+	at.att_id[0] = 'A'; at.att_id[1] = 'T';
+	at.att_id[2] = 'T'; at.att_id[3] = ' ';
+	at.att_version = 1;
+	if (is_auditor) {
+		at.att_maaudit = 1;
+		b = (unsigned char *)&at.att_auditoraudit;
+	} else {
+		at.att_muaudit = 1;
+		b = (unsigned char *)&at.att_useraudit;
+	}
+	b[0] = (unsigned char)v[0];
+	b[1] = (unsigned char)v[1];
+	b[2] = (unsigned char)v[2];
+	{
+		int r2 = zos_chattr(a, &at, is_auditor ?
+		    "auditoraudit" : "useraudit");
+		if (r2 < ret) ret = r2;
+	}
+	return (ret);
+}
+
+/* Apply the extattr "apsl" flags (NUL-terminated 4-char string). */
+static int
+zos_set_extattr(struct archive_write_disk *a, const char *apsl)
+{
+	attrib_t at;
+
+	memset(&at, 0, sizeof(at));
+	at.att_id[0] = 'A'; at.att_id[1] = 'T';
+	at.att_id[2] = 'T'; at.att_id[3] = ' ';
+	at.att_version = 1;
+	at.att_setgen = 1;
+	if (apsl[0] == 'a' || apsl[0] == '-') {
+		at.att_apfauthmask = 1;
+		at.att_apfauth = (apsl[0] == 'a');
+	}
+	if (apsl[1] == 'p' || apsl[1] == '-') {
+		at.att_progctlmask = 1;
+		at.att_progctl = (apsl[1] == 'p');
+	}
+	if (apsl[2] == 's' || apsl[2] == '-') {
+		at.att_noshareasmask = 1;
+		/* 's' set = sharing allowed */
+		at.att_noshareas = (apsl[2] != 's');
+	}
+	if (apsl[3] == 'l' || apsl[3] == '-') {
+		at.att_sharelibmask = 1;
+		at.att_sharelib = (apsl[3] == 'l');
+	}
+	return (zos_chattr(a, &at, "extattr"));
+}
+
+static int
+set_zos_attributes(struct archive_write_disk *a, int taginfo_only)
+{
+	struct archive_entry *entry = a->entry;
+	int ret = ARCHIVE_OK, r2;
+	int i = archive_entry_xattr_reset(entry);
+	int is_link = LA_S_ISLNK(a->mode);
+	int is_dir = LA_S_ISDIR(a->mode);
+	int is_reg = LA_S_ISREG(a->mode);
+	/* IBM pax dialect (ZOS.taginfo, ZOS.useraudit,
+	 * ZOS.auditoraudit, ZOS.filefmt, ZOS.extattr) and zopen GNU
+	 * tar dialect (ZOS.ccsid, ZOS.txtflag, ZOS.genvalue), all
+	 * stored on the entry as extended attributes by the readers. */
+	const char *taginfo = NULL, *useraudit = NULL;
+	const char *auditoraudit = NULL, *filefmt = NULL, *extattr = NULL;
+	size_t taginfo_l = 0, useraudit_l = 0, auditoraudit_l = 0;
+	size_t filefmt_l = 0, extattr_l = 0;
+	long tarport_ccsid = -1, tarport_txtflag = -1, tarport_genvalue = -1;
+	char buf[64];
+
+	/* First pass: collect the ZOS.* attribute values. */
+	while (i--) {
+		const char *name;
+		const void *value;
+		size_t size;
+
+		archive_entry_xattr_next(entry, &name, &value, &size);
+		if (name == NULL || value == NULL || size == 0
+		    || strncmp(name, "ZOS.", 4) != 0)
+			continue;
+		if (size > sizeof(buf) - 1)
+			continue;	/* Unreasonably long; ignore. */
+		memcpy(buf, value, size);
+		buf[size] = '\0';
+
+		if (strcmp(name, "ZOS.taginfo") == 0) {
+			taginfo = value; taginfo_l = size;
+		} else if (strcmp(name, "ZOS.useraudit") == 0) {
+			useraudit = value; useraudit_l = size;
+		} else if (strcmp(name, "ZOS.auditoraudit") == 0) {
+			auditoraudit = value; auditoraudit_l = size;
+		} else if (strcmp(name, "ZOS.filefmt") == 0) {
+			filefmt = value; filefmt_l = size;
+		} else if (strcmp(name, "ZOS.extattr") == 0) {
+			extattr = value; extattr_l = size;
+		} else if (strcmp(name, "ZOS.ccsid") == 0) {
+			tarport_ccsid = atol(buf);
+		} else if (strcmp(name, "ZOS.txtflag") == 0) {
+			tarport_txtflag = atol(buf);
+		} else if (strcmp(name, "ZOS.genvalue") == 0) {
+			tarport_genvalue = atol(buf);
+		}
+		/* ZOS.acls: stored on the entry but not yet restored. */
+	}
+
+	/*
+	 * File tag.  z/OS cannot tag symlinks; only regular files
+	 * and directories can be tagged.
+	 */
+	if (!is_link && (is_reg || is_dir) && taginfo_only) {
+		int txtflag = -1;
+		long ccsid = 0;
+
+		if (taginfo != NULL && taginfo_l < sizeof(buf)) {
+			/* "txtflag [ccsid]" (IBM pax) */
+			memcpy(buf, taginfo, taginfo_l);
+			buf[taginfo_l] = '\0';
+			txtflag = buf[0] - '0';
+			if (txtflag != 0 && txtflag != 1)
+				txtflag = -1;
+			else if (buf[1] == ' ')
+				ccsid = atol(buf + 2);
+			else if (buf[1] != '\0')
+				txtflag = -1;
+		} else if (tarport_ccsid >= 0 || tarport_txtflag >= 0) {
+			/* Numeric ccsid/txtflag pair (zopen GNU tar) */
+			ccsid = (tarport_ccsid >= 0) ? tarport_ccsid : 0;
+			txtflag = (tarport_txtflag >= 0) ? tarport_txtflag : 0;
+		}
