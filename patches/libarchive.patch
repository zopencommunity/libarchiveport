+		} else if (strcmp(name, "ZOS.useraudit") == 0) {
+			useraudit = value; useraudit_l = size;
+		} else if (strcmp(name, "ZOS.auditoraudit") == 0) {
+			auditoraudit = value; auditoraudit_l = size;
+		} else if (strcmp(name, "ZOS.filefmt") == 0) {
+			filefmt = value; filefmt_l = size;
+		} else if (strcmp(name, "ZOS.extattr") == 0) {
