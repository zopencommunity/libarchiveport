+	/* User/auditor audit flags: three chars (read/write/execute). */
+	if (!is_link && useraudit != NULL && useraudit_l == 3)
+		ret = zos_set_audit(a, ret, 0, useraudit);
+	if (!is_link && auditoraudit != NULL && auditoraudit_l == 3)
+		ret = zos_set_audit(a, ret, 1, auditoraudit);
