 {
 	entry->stat_valid = 0;
+#ifdef __MVS__
+	/* z/OS S_IF* constants occupy different bit positions than AE_IF*.
+	 * If the caller passed a native S_IF* value (bits outside AE_IFMT),
+	 * translate the file type to AE_IF* while preserving the permission bits. */
