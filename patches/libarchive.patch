+ * read/write/execute, with values 0=none 1=success 2=failure 3=both.)
+ */
+static int
+zos_audit_char(char c)
+{
+	switch (c) {
+	case '-': return (0);
+	case 's': return (1);
+	case 'f': return (2);
+	case 'a': return (3);
+	default:  return (-1);
+	}
