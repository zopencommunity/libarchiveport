 {
 	entry->stat_valid = 0;
+#ifdef __MVS__
+	/* z/OS S_IF* constants occupy different bit positions than AE_IF*.
+	 * If the caller passed a native S_IF* value (bits outside AE_IFMT),
+	 * translate the file type to AE_IF* while preserving the permission bits. */
+	if (m & ~(__LA_MODE_T)07777 & ~(__LA_MODE_T)AE_IFMT) {
+		__LA_MODE_T perm = m & 07777;
+		if (S_ISREG(m))        m = AE_IFREG  | perm;
+		else if (S_ISDIR(m))   m = AE_IFDIR  | perm;
+		else if (S_ISLNK(m))   m = AE_IFLNK  | perm;
+		else if (S_ISBLK(m))   m = AE_IFBLK  | perm;
+		else if (S_ISCHR(m))   m = AE_IFCHR  | perm;
+		else if (S_ISFIFO(m))  m = AE_IFIFO  | perm;
+		else if (S_ISSOCK(m))  m = AE_IFSOCK | perm;
+	}
+#endif
 	entry->acl.mode = m;
 	entry->ae_set |= AE_SET_PERM | AE_SET_FILETYPE;
 }
@@ -1309,7 +1324,13 @@ archive_entry_set_perm(struct archive_entry *entry, __LA_MODE_T p)
 {
 	entry->stat_valid = 0;
 	entry->acl.mode &= AE_IFMT;
+#ifdef __MVS__
+	/* z/OS stat modes carry the file type in high-order bits that
+	 * fall outside AE_IFMT; keep only the permission bits. */
+	entry->acl.mode |= 07777 & p;
