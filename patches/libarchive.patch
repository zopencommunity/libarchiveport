+{
+	if ((key_length == 11 && memcmp(key, "ZOS.taginfo", 11) == 0) ||
+	    (key_length == 13 && memcmp(key, "ZOS.useraudit", 13) == 0) ||
+	    (key_length == 16 && memcmp(key, "ZOS.auditoraudit", 16) == 0) ||
+	    (key_length == 11 && memcmp(key, "ZOS.filefmt", 11) == 0) ||
+	    (key_length == 11 && memcmp(key, "ZOS.extattr", 11) == 0) ||
+	    (key_length == 8 && memcmp(key, "ZOS.acls", 8) == 0) ||
+	    (key_length == 9 && memcmp(key, "ZOS.ccsid", 9) == 0) ||
+	    (key_length == 11 && memcmp(key, "ZOS.txtflag", 11) == 0) ||
+	    (key_length == 12 && memcmp(key, "ZOS.genvalue", 12) == 0))
