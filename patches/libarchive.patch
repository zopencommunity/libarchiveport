+		__LA_MODE_T perm = m & 07777;
+		if (S_ISREG(m))        m = AE_IFREG  | perm;
+		else if (S_ISDIR(m))   m = AE_IFDIR  | perm;
+		else if (S_ISLNK(m))   m = AE_IFLNK  | perm;
+		else if (S_ISBLK(m))   m = AE_IFBLK  | perm;
+		else if (S_ISCHR(m))   m = AE_IFCHR  | perm;
+		else if (S_ISFIFO(m))  m = AE_IFIFO  | perm;
+		else if (S_ISSOCK(m))  m = AE_IFSOCK | perm;
+	}
+#endif
 	entry->acl.mode = m;
 	entry->ae_set |= AE_SET_PERM | AE_SET_FILETYPE;
 }
@@ -1309,7 +1324,13 @@ archive_entry_set_perm(struct archive_entry *entry, __LA_MODE_T p)
 {
