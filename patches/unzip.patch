diff --git a/unzip/bsdunzip.c b/unzip/bsdunzip.c
index e6426d5..8bfc3f4 100644
--- a/unzip/bsdunzip.c
+++ b/unzip/bsdunzip.c
@@ -842,7 +842,7 @@ extract(struct archive *a, struct archive_entry *e)
 		return;
 	}
 
-	if (S_ISLNK(filetype) &&
+	if (archive_entry_filetype(e) == AE_IFLNK &&
 	    ((linktarget = archive_entry_symlink(e)) != NULL) &&
 	    pathname_is_insecure(linktarget)) {
 		warningx("skipping insecure symlink '%s' to '%s'", pathname, linktarget);
@@ -852,7 +852,8 @@ extract(struct archive *a, struct archive_entry *e)
 	}
 
 	/* I don't think this can happen in a zipfile.. */
