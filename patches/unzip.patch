@@ -653,6 +653,55 @@ extract2fd(struct archive *a, char *pathname, int fd)
 /*
  * Extract a regular file.
  */
+/*
+ * Restore the z/OS file tag recorded by the zip reader from the
+ * "zs" extra field (stored on the entry as a ZOS.taginfo extended
+ * attribute): "1 <ccsid>" (text), "0 <ccsid>" (binary), "0"
+ * (untagged).
+ */
+#ifdef __MVS__
+static void
+set_zos_tag(struct archive_entry *e, int fd, const char *path)
+{
+	attrib_t at;
+	char buf[33];
+	const char *name;
+	const void *value;
+	size_t size;
+	long ccsid = 0;
+	int i = archive_entry_xattr_reset(e);
+	int txtflag;
+
+	while (i--) {
+		archive_entry_xattr_next(e, &name, &value, &size);
+		if (name != NULL && strcmp(name, "ZOS.taginfo") == 0)
+			break;
+	}
+	if (i < 0 || size < 1 || size > sizeof(buf) - 1)
+		return;
+	memcpy(buf, value, size);
+	buf[size] = '\0';
+	txtflag = buf[0] - '0';
+	if (txtflag != 0 && txtflag != 1)
+		return;
+	if (buf[1] == ' ')
+		ccsid = atol(buf + 2);
+	else if (buf[1] != '\0')
+		return;
+	if (ccsid < 0 || ccsid > 65535)
+		return;
+	memset(&at, 0, sizeof(at));
+	at.att_id[0] = 'A'; at.att_id[1] = 'T';
+	at.att_id[2] = 'T'; at.att_id[3] = ' ';
+	at.att_version = 1;
+	at.att_filetagchg = 1;
+	at.att_filetag.ft_ccsid = (unsigned short)ccsid;
+	at.att_filetag.ft_txtflag = txtflag;
+	if (__fchattr(fd, &at, sizeof(at)) != 0)
+		warning("Cannot set file tag for '%s'", path);
+}
+#endif
+
 static void
 extract_file(struct archive *a, struct archive_entry *e, char **path)
 {
@@ -763,6 +812,11 @@ recheck:
 
