diff --git a/test_utils/test_common.h b/test_utils/test_common.h
index ed31fb1..71d8285 100644
--- a/test_utils/test_common.h
+++ b/test_utils/test_common.h
@@ -428,6 +428,95 @@ extern const char *testworkdir;
 #include "archive.h"
 #include "archive_entry.h"
 
+#ifdef __MVS__
+/*
+ * z/OS portability notes for the test suite:
+ *
+ * z/OS stat(2) reports file types in high-order mode bits
+ * (S_IFMT == 0xFF000000, S_IFREG == 0x03000000, ...), while
+ * libarchive stores archive_entry modes using the standard POSIX
+ * AE_IF* values in bits 12..15.  To keep the (unmodified) upstream
+ * tests working, do three things here:
+ *
+ *   1. Capture the native z/OS S_IS*() checks as functions before the
+ *      S_IF* constants are remapped (their bodies are expanded while
+ *      the native definitions are still in effect).
+ *   2. Remap the S_IF* constants to the AE_IF* equivalents so that
+ *      expressions such as (S_IFREG | 0755) compare equal to
+ *      archive_entry_mode() values.
+ *   3. Redefine the S_IS*() macros to recognize both encodings, so
+ *      they keep working on raw stat(2) results as well.
+ *
+ * test_st_mode() below additionally converts a z/OS st_mode into the
+ * AE_IF* encoding so tests can compare stat results against
+ * archive_entry modes.
+ */
+static inline int	test_zos_isreg(mode_t m)  { return (S_ISREG(m)); }
+static inline int	test_zos_isdir(mode_t m)  { return (S_ISDIR(m)); }
+static inline int	test_zos_islnk(mode_t m)  { return (S_ISLNK(m)); }
+static inline int	test_zos_isblk(mode_t m)  { return (S_ISBLK(m)); }
+static inline int	test_zos_ischr(mode_t m)  { return (S_ISCHR(m)); }
+static inline int	test_zos_isfifo(mode_t m) { return (S_ISFIFO(m)); }
+static inline int	test_zos_issock(mode_t m) { return (S_ISSOCK(m)); }
+
+#undef	S_IFMT
+#undef	S_IFREG
+#undef	S_IFDIR
+#undef	S_IFLNK
+#undef	S_IFBLK
+#undef	S_IFCHR
+#undef	S_IFIFO
+#undef	S_IFSOCK
+#define	S_IFMT		AE_IFMT
+#define	S_IFREG	AE_IFREG
+#define	S_IFDIR	AE_IFDIR
+#define	S_IFLNK	AE_IFLNK
+#define	S_IFBLK	AE_IFBLK
+#define	S_IFCHR	AE_IFCHR
+#define	S_IFIFO	AE_IFIFO
+#define	S_IFSOCK	AE_IFSOCK
+
+#undef	S_ISREG
+#undef	S_ISDIR
+#undef	S_ISLNK
+#undef	S_ISBLK
+#undef	S_ISCHR
+#undef	S_ISFIFO
+#undef	S_ISSOCK
+#define	S_ISREG(m)	(((m) & AE_IFMT) == AE_IFREG || test_zos_isreg(m))
+#define	S_ISDIR(m)	(((m) & AE_IFMT) == AE_IFDIR || test_zos_isdir(m))
+#define	S_ISLNK(m)	(((m) & AE_IFMT) == AE_IFLNK || test_zos_islnk(m))
+#define	S_ISBLK(m)	(((m) & AE_IFMT) == AE_IFBLK || test_zos_isblk(m))
+#define	S_ISCHR(m)	(((m) & AE_IFMT) == AE_IFCHR || test_zos_ischr(m))
+#define	S_ISFIFO(m)	(((m) & AE_IFMT) == AE_IFIFO || test_zos_isfifo(m))
+#define	S_ISSOCK(m)	(((m) & AE_IFMT) == AE_IFSOCK || test_zos_issock(m))
+
+/* Convert a z/OS stat(2) st_mode into the AE_IF* encoding used by
+ * archive_entry, so both sides of a comparison are in the same
+ * representation. */
+static inline __LA_MODE_T
+test_st_mode(const struct stat *st)
+{
+	__LA_MODE_T perm = (__LA_MODE_T)(st->st_mode & 07777);
+
+	if (test_zos_isdir(st->st_mode))
+		return (AE_IFDIR | perm);
+	if (test_zos_islnk(st->st_mode))
+		return (AE_IFLNK | perm);
+	if (test_zos_isblk(st->st_mode))
+		return (AE_IFBLK | perm);
+	if (test_zos_ischr(st->st_mode))
+		return (AE_IFCHR | perm);
+	if (test_zos_isfifo(st->st_mode))
+		return (AE_IFIFO | perm);
+	if (test_zos_issock(st->st_mode))
+		return (AE_IFSOCK | perm);
+	if (test_zos_isreg(st->st_mode))
+		return (AE_IFREG | perm);
+	return (perm);
+}
+#endif /* __MVS__ */
+
 /* ACL structure */
 struct archive_test_acl_t {
 	int type;  /* Type of ACL */
